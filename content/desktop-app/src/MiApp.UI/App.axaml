<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MiApp.UI.Views"
             x:Class="MiApp.UI.App"
             RequestedThemeVariant="Default">

    <!-- Asocia cada ViewModel con su vista -->
    <Application.DataTemplates>
        <views:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MiApp.UI/Assets/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MiApp.UI/Assets/Styles.axaml" />
    </Application.Styles>
</Application>
